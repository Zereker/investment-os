{
  "name": "investment-os",
  "description": "A policy-driven investment decision skill that reads the policy files distributed with it and fresh broker state while preserving privacy and human execution authority.",
  "version": "0.3.0",
  "author": {
    "name": "Zereker"
  },
  "homepage": "https://github.com/Zereker/investment-os",
  "repository": "https://github.com/Zereker/investment-os",
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "investment-policy",
    "portfolio-review",
    "risk-controls",
    "ibkr"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/claude-session-start\"",
            "shell": "bash",
            "async": false
          }
        ]
      }
    ]
  }
}
