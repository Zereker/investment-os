#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/../../.." && pwd)"
SKILL_PATH="${PLUGIN_ROOT}/skills/using-investment-os/SKILL.md"

if [ ! -f "$SKILL_PATH" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"Investment OS bootstrap unavailable: the canonical using-investment-os skill is missing. Do not perform formal Investment OS work."}}\n'
  exit 0
fi

content=$(cat "$SKILL_PATH")
escape_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

escaped=$(escape_json "$content")
context="<INVESTMENT_OS_BOOTSTRAP>\nInvestment OS is installed as one canonical rule skill. Resolve every policy file and internal deterministic script from this installed plugin distribution, not from the current working directory or a runtime network fetch. Missing broker or market capability must fail closed only the affected path. Follow the canonical skill below.\n\n${escaped}\n</INVESTMENT_OS_BOOTSTRAP>"
printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$context"
