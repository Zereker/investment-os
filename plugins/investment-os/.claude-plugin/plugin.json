{
  "name": "investment-os",
  "description": "A rules-first long-term investment agent with one canonical skill, fresh runtime facts, and owner-authorized execution.",
  "version": "0.7.1",
  "author": {
    "name": "Zereker"
  },
  "homepage": "https://github.com/Zereker/investment-os",
  "repository": "https://github.com/Zereker/investment-os",
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "investment-policy",
    "portfolio-review",
    "risk-controls",
    "ibkr"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/skills/using-investment-os/scripts/claude-session-start\"",
            "shell": "bash",
            "async": false
          }
        ]
      }
    ]
  }
}
