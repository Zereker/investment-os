{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "investment-os-mcp",
  "main": "cloudflare/server.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.md"],
      "fallthrough": true
    }
  ]
}
